<!--
  Janela do aviso que aparece na TV da mesa de som.

  Ela cobre o monitor inteiro, mas é transparente, fica sempre por cima
  (inclusive do projetor em tela cheia do OBS), não recebe cliques e nunca
  rouba o foco. Só o "cartão" com o sino e a mensagem fica visível.
-->
<Window x:Class="IevcLivestreamHelper.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEVC Livestream Helper — aviso na TV"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Width="1280" Height="720">

  <Window.Resources>
    <!-- Paleta do aviso: amarelo quentinho → coral, texto marrom bem escuro (alto contraste). -->
    <SolidColorBrush x:Key="TextBrush" Color="#2B1300" />
    <SolidColorBrush x:Key="SubtitleBrush" Color="#7A2E0E" />
    <SolidColorBrush x:Key="BellGoldBrush" Color="#FFC93C" />
    <SolidColorBrush x:Key="BellOutlineBrush" Color="#E0A100" />
    <SolidColorBrush x:Key="BellClapperBrush" Color="#7A3E00" />
  </Window.Resources>

  <Grid>
    <!-- O cartão ocupa a faixa central (80%) da largura da TV. -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="8*" />
      <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="Card"
            Grid.Column="1"
            VerticalAlignment="Top"
            Margin="0,56,0,0"
            Padding="44,36,44,32"
            CornerRadius="44"
            BorderBrush="White"
            BorderThickness="8"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFD966" Offset="0" />
          <GradientStop Color="#FF9A6B" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect BlurRadius="48" ShadowDepth="6" Opacity="0.45" Color="#5A2000" />
      </Border.Effect>
      <Border.RenderTransform>
        <TransformGroup>
          <!-- "Respiração" suave do cartão. -->
          <ScaleTransform x:Name="CardPulse" />
          <!-- Entrada deslizando de cima. -->
          <TranslateTransform x:Name="CardSlide" />
        </TransformGroup>
      </Border.RenderTransform>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
          <!-- Sino num círculo branco. -->
          <Border DockPanel.Dock="Left"
                  Width="170" Height="170"
                  CornerRadius="85"
                  Background="White"
                  VerticalAlignment="Center">
            <Viewbox Margin="26">
              <Canvas Width="100" Height="100">
                <Canvas.RenderTransform>
                  <!-- Gira a partir do "pino" de cima, como um sino de verdade. -->
                  <RotateTransform x:Name="BellSwing" CenterX="50" CenterY="8" />
                </Canvas.RenderTransform>

                <Ellipse Canvas.Left="44" Canvas.Top="3" Width="12" Height="12"
                         Fill="{StaticResource BellGoldBrush}" />
                <Path Fill="{StaticResource BellGoldBrush}"
                      Stroke="{StaticResource BellOutlineBrush}" StrokeThickness="2"
                      Data="M50,12 C30,12 22,30 22,48 L22,64 L12,76 L88,76 L78,64 L78,48 C78,30 70,12 50,12 Z" />
                <Rectangle Canvas.Left="8" Canvas.Top="72" Width="84" Height="12"
                           RadiusX="6" RadiusY="6"
                           Fill="{StaticResource BellGoldBrush}"
                           Stroke="{StaticResource BellOutlineBrush}" StrokeThickness="2" />
                <Ellipse Canvas.Left="41" Canvas.Top="82" Width="18" Height="18"
                         Fill="{StaticResource BellClapperBrush}" />
                <!-- Brilho, para ficar fofinho. -->
                <Path Stroke="White" StrokeThickness="5" Opacity="0.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M33,52 C33,36 39,26 48,23" />
              </Canvas>
            </Viewbox>
          </Border>

          <StackPanel Margin="40,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Recado da mesa de corte"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SubtitleBrush}" />
            <TextBlock x:Name="MessageText"
                       Text="Mensagem"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="80"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" />
          </StackPanel>
        </DockPanel>

        <!-- Barrinha que vai esvaziando até o aviso sumir. -->
        <Border Grid.Row="1"
                Margin="0,30,0,0"
                Height="16"
                CornerRadius="8"
                Background="#8CFFFFFF">
          <Border CornerRadius="8"
                  Background="#C2452A"
                  RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="TimeLeftBar" />
            </Border.RenderTransform>
          </Border>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
