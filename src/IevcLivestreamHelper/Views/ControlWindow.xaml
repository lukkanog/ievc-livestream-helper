<!--
  Janelinha do operador (mesa de corte), no estilo "bichinho de estimação":
  pequena, sempre por cima, dá para arrastar para qualquer lugar e recolher
  numa bolinha. Daqui o operador manda os avisos para a TV da mesa de som.
-->
<Window x:Class="IevcLivestreamHelper.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEVC Livestream Helper"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#2B1300">

  <Window.Resources>
    <!-- ===== Cores ===== -->
    <!-- Contraste alto: texto branco no coral escuro e texto marrom-escuro nos fundos claros. -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#C43D1F" />
    <SolidColorBrush x:Key="SoftYellowBrush" Color="#FFE08A" />
    <SolidColorBrush x:Key="SoftYellowBorderBrush" Color="#E0B44A" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B4E3D" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E3CDB9" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#8A6A58" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#5A2000" />

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Margin" Value="0,10,0,6" />
    </Style>

    <!-- ===== Botão arredondado (base para os outros) ===== -->
    <Style x:Key="RoundButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource SoftYellowBrush}" />
      <Setter Property="Foreground" Value="#2B1300" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shape"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shape" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shape" Property="Opacity" Value="0.7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuickMessageButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource SoftYellowBorderBrush}" />
    </Style>

    <!-- Botão principal: Enviar. O maior e mais forte da janelinha. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Limpar: secundário, discreto mas legível. -->
    <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#3D2A20" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="Background" Value="#F3E4D6" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Margin" Value="0,6,6,0" />
    </Style>

    <!-- Botõezinhos de ícone do cabeçalho (configurações, recolher, fechar). -->
    <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
  </Window.Resources>

  <!-- Margem externa: espaço para a sombra aparecer. -->
  <Grid Margin="14">

    <!-- ================= Modo aberto ================= -->
    <Border x:Name="ExpandedView"
            Width="320"
            Background="#FFF8F1"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="14,8,14,14"
            Effect="{StaticResource SoftShadow}">
      <StackPanel>

        <!-- Cabeçalho: segure aqui para arrastar a janelinha. -->
        <DockPanel Background="Transparent" Cursor="SizeAll"
                   MouseLeftButtonDown="OnDragAreaMouseDown"
                   ToolTip="Segure e arraste para mudar a janelinha de lugar">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Cursor="Arrow">
            <Button Style="{StaticResource HeaderIconButton}" Content="&#xE713;"
                    ToolTip="Configurações" Click="OnToggleSettingsClick" />
            <Button Style="{StaticResource HeaderIconButton}" Content="&#xE921;"
                    ToolTip="Recolher numa bolinha" Click="OnCollapseClick" />
            <Button Style="{StaticResource HeaderIconButton}" Content="&#xE8BB;"
                    ToolTip="Fechar o app" Click="OnCloseClick" />
          </StackPanel>
          <Image Source="/Assets/app.ico" Width="22" Height="22" Margin="0,0,8,0" />
          <TextBlock Text="IEVC Livestream Helper" FontWeight="Bold" FontSize="13"
                     VerticalAlignment="Center" />
        </DockPanel>

        <!-- O que está na TV agora. -->
        <Border x:Name="StatusPanel" CornerRadius="10" Padding="10,7" Margin="0,8,0,0"
                Background="#EEF7EE">
          <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#2B1300" />
        </Border>

        <!-- Mensagens rápidas. -->
        <TextBlock Text="AVISOS PARA A TV" Style="{StaticResource SectionTitle}" />
        <ItemsControl x:Name="QuickMessagesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource QuickMessageButton}" Click="OnQuickMessageClick">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
          Mensagem personalizada: caixa de texto grande (várias linhas).
          Enter envia; Shift+Enter pula linha.
        -->
        <TextBlock Text="OUTRA MENSAGEM" Style="{StaticResource SectionTitle}" />
        <Border Background="White" CornerRadius="10" BorderThickness="2"
                BorderBrush="{StaticResource InputBorderBrush}">
          <Grid>
            <!-- Dica que aparece só enquanto a caixa está vazia. -->
            <TextBlock x:Name="CustomMessagePlaceholder"
                       Text="Escreva aqui o aviso para a TV…"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="15" Margin="10,9,10,0"
                       IsHitTestVisible="False" />
            <TextBox x:Name="CustomMessageBox"
                     FontSize="15" Foreground="#2B1300"
                     Background="Transparent" BorderThickness="0"
                     Padding="6,7" MinHeight="72" MaxHeight="140"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Enter envia. Shift+Enter pula linha."
                     PreviewKeyDown="OnCustomMessageKeyDown"
                     TextChanged="OnCustomMessageTextChanged" />
          </Grid>
        </Border>

        <Button Style="{StaticResource PrimaryButton}" Content="Enviar para a TV"
                Margin="0,8,0,0" Click="OnSendCustomMessageClick" />

        <Button Style="{StaticResource ClearButton}" Content="Limpar aviso da TV"
                Margin="0,6,0,0" Click="OnClearClick" />

        <!-- Configurações (aparecem ao clicar na engrenagem). -->
        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
          <TextBlock Text="CONFIGURAÇÕES" Style="{StaticResource SectionTitle}" />

          <TextBlock Text="Tela da TV" Margin="0,0,0,4" />
          <ComboBox x:Name="MonitorPicker" DisplayMemberPath="DisplayName"
                    Padding="6,5" SelectionChanged="OnMonitorPickerChanged" />
          <WrapPanel>
            <Button Content="Testar" Style="{StaticResource SmallButton}"
                    ToolTip="Mostra um aviso de teste na tela escolhida"
                    Click="OnTestClick" />
            <Button Content="Atualizar lista" Style="{StaticResource SmallButton}"
                    ToolTip="Procura de novo os monitores ligados"
                    Click="OnRefreshMonitorsClick" />
          </WrapPanel>

          <DockPanel Margin="0,10,0,0">
            <TextBlock x:Name="DurationLabel" DockPanel.Dock="Right" FontWeight="SemiBold" />
            <TextBlock Text="Duração do aviso" />
          </DockPanel>
          <Slider x:Name="DurationSlider" Margin="0,4,0,0"
                  Minimum="5" Maximum="120"
                  TickFrequency="5" IsSnapToTickEnabled="True"
                  ValueChanged="OnDurationChanged" />

          <WrapPanel Margin="0,6,0,0">
            <Button Content="Editar mensagens…" Style="{StaticResource SmallButton}"
                    ToolTip="Abre o arquivo configuracoes.json no Bloco de Notas"
                    Click="OnEditSettingsFileClick" />
            <Button Content="Recarregar" Style="{StaticResource SmallButton}"
                    ToolTip="Lê de novo o configuracoes.json depois de editar"
                    Click="OnReloadSettingsClick" />
            <Button Content="Abrir registros (log)" Style="{StaticResource SmallButton}"
                    ToolTip="Abre a pasta com os arquivos de registro, úteis quando algo dá errado"
                    Click="OnOpenLogsClick" />
          </WrapPanel>
        </StackPanel>

        <!-- Problemas (fica escondido se está tudo certo). -->
        <TextBlock x:Name="ProblemsText"
                   Foreground="#B3401F" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <!-- ================= Modo recolhido (bolinha) ================= -->
    <!-- Clique para abrir; segure e arraste para mudar de lugar. -->
    <Grid x:Name="CollapsedView" Visibility="Collapsed" Cursor="Hand"
          ToolTip="Clique para abrir. Segure e arraste para mudar de lugar."
          MouseLeftButtonDown="OnBubbleMouseDown">
      <Border x:Name="Bubble"
              Width="60" Height="60" CornerRadius="30"
              Background="White"
              BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="3"
              Effect="{StaticResource SoftShadow}">
        <Image Source="/Assets/app.ico" Margin="9" />
      </Border>

      <!-- Contador: aparece enquanto há aviso na TV. -->
      <Border x:Name="BubbleBadge"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,-4,-6,0" MinWidth="24" Height="22" CornerRadius="11"
              Padding="5,0" Background="{StaticResource PrimaryBrush}"
              BorderBrush="White" BorderThickness="2"
              Visibility="Collapsed">
        <TextBlock x:Name="BubbleBadgeText" Foreground="White" FontSize="11" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
  </Grid>
</Window>
