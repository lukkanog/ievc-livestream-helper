<!--
  Janela do operador (mesa de corte).
  Daqui ele manda os avisos para a TV da mesa de som.
-->
<Window x:Class="IevcLivestreamHelper.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sininho da Live — IEVC"
        Icon="/Assets/sininho.ico"
        Width="560"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F1"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#2B1300">

  <Window.Resources>
    <!-- ===== Cores ===== -->
    <SolidColorBrush x:Key="CoralBrush" Color="#FF7A59" />
    <SolidColorBrush x:Key="SoftYellowBrush" Color="#FFE7A8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8A6A58" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#F1DFCF" />

    <!-- ===== Painel branco arredondado ===== -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ===== Botão arredondado (base para os outros) ===== -->
    <Style x:Key="RoundButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource SoftYellowBrush}" />
      <Setter Property="Foreground" Value="#2B1300" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shape"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shape" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shape" Property="Opacity" Value="0.7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shape" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuickMessageButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="Background" Value="{StaticResource CoralBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="Background" Value="#3D2A20" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
      <Setter Property="Background" Value="#F6EADF" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,18,20,12">

    <!-- ===== Cabeçalho ===== -->
    <DockPanel Margin="0,0,0,14">
      <Image Source="/Assets/sininho.ico" Width="48" Height="48" Margin="0,0,12,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Sininho da Live" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="Avisos da mesa de corte para a TV da mesa de som"
                   Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>
    </DockPanel>

    <!-- ===== O que está na TV agora ===== -->
    <Border x:Name="StatusPanel" Style="{StaticResource Panel}" Background="#EEF7EE">
      <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>

    <!-- ===== Mensagens rápidas ===== -->
    <Border Style="{StaticResource Panel}">
      <StackPanel>
        <TextBlock Text="MENSAGENS RÁPIDAS" Style="{StaticResource SectionTitle}" />
        <ItemsControl x:Name="QuickMessagesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource QuickMessageButton}" Click="OnQuickMessageClick">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right"
                             Text="{Binding HotkeyLabel}"
                             FontSize="12" FontWeight="Normal"
                             Foreground="{StaticResource MutedTextBrush}"
                             VerticalAlignment="Center" Margin="12,0,0,0" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== Mensagem personalizada ===== -->
    <Border Style="{StaticResource Panel}">
      <StackPanel>
        <TextBlock Text="MENSAGEM PERSONALIZADA" Style="{StaticResource SectionTitle}" />
        <DockPanel>
          <!-- IsDefault: apertar Enter na caixa de texto já envia. -->
          <Button DockPanel.Dock="Right" Content="Enviar"
                  Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                  IsDefault="True" Click="OnSendCustomMessageClick" />
          <TextBox x:Name="CustomMessageBox"
                   FontSize="16" Padding="8,8"
                   VerticalContentAlignment="Center"
                   BorderBrush="{StaticResource PanelBorderBrush}"
                   ToolTip="Digite e aperte Enter para mandar para a TV" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- ===== Limpar ===== -->
    <Button x:Name="ClearButton" Style="{StaticResource ClearButton}"
            Content="Limpar aviso da TV" Margin="0,0,0,12"
            Click="OnClearClick" />

    <!-- ===== Configurações ===== -->
    <Border Style="{StaticResource Panel}">
      <StackPanel>
        <TextBlock Text="CONFIGURAÇÕES" Style="{StaticResource SectionTitle}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Tela da TV -->
          <TextBlock Text="Tela da TV:" VerticalAlignment="Center" Margin="0,0,12,0" />
          <DockPanel Grid.Column="1">
            <Button DockPanel.Dock="Right" Content="Testar" Style="{StaticResource SmallButton}"
                    ToolTip="Mostra um aviso de teste na tela escolhida"
                    Click="OnTestClick" />
            <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource SmallButton}"
                    ToolTip="Procura de novo os monitores ligados"
                    Click="OnRefreshMonitorsClick" />
            <ComboBox x:Name="MonitorPicker" DisplayMemberPath="DisplayName"
                      VerticalContentAlignment="Center" Padding="8,6"
                      SelectionChanged="OnMonitorPickerChanged" />
          </DockPanel>

          <!-- Duração -->
          <TextBlock Grid.Row="1" Text="Duração do aviso:" VerticalAlignment="Center" Margin="0,14,12,0" />
          <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
            <TextBlock x:Name="DurationLabel" DockPanel.Dock="Right" Width="52"
                       TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Slider x:Name="DurationSlider"
                    Minimum="5" Maximum="120"
                    TickFrequency="5" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="OnDurationChanged" />
          </DockPanel>
        </Grid>

        <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Right">
          <Button Content="Editar mensagens e atalhos…" Style="{StaticResource SmallButton}"
                  ToolTip="Abre o arquivo configuracoes.json no Bloco de Notas"
                  Click="OnEditSettingsFileClick" />
          <Button Content="Recarregar" Style="{StaticResource SmallButton}"
                  ToolTip="Lê de novo o configuracoes.json depois de editar"
                  Click="OnReloadSettingsClick" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Avisos sobre atalhos que não funcionaram (fica escondido se está tudo certo). -->
    <TextBlock x:Name="ProblemsText"
               Foreground="#B3401F" TextWrapping="Wrap" Margin="4,0,4,8"
               Visibility="Collapsed" />
  </StackPanel>
</Window>
